#  /__/ /_/|  | . \ |_| || | |  _  |   | |_) | |_| || | | |___    ___) | . \ 
#  \_/ \____| |_|\_\___/ |_| |_| |_|   |____/___/ |_| |_____|  |____/|_|\_\
#                                                                           
#  - Name: SQKOTH (King of the Hill)
#  - Version: 5.1.1 (The /sqkoth set command has been fixed)
#  - Category: BoxPvP / PvP MiniGame Mini-Engine
#  - Environment: Vanilla Skript (Zero Addons Required)
#  - Compatible Software: Minecraft 1.21.1+ (Paper / Purpur)
#  - Required Plugins: Skript, FancyHolograms, Vault, EssentialsX
#  - Discord: https://discord.gg/28pTmAYCwH
#  - Tutorial: https://github.com/amajd3078/SQKoth---King-of-the-hill
# ==========================================================================

# ==========================================
#       QUICK CONFIGURATION SETUP
# ==========================================
options:
    prefix: &6&lS&e&lQ&6&lKOTH &8»&f
    hologram: koth_hologram 

    # --- BOX-PVP ZONE RANGE SETUP ---
    hill_radius: 4                        # Horizontal distance around center
    hill_height: 3                        # Vertical height limit above/below center

    # --- QUICK REWARD SETTINGS ---
    reward_money: 5000
    crate_command: crate key give [PLAYER] common 1 
    
    # --- AUTOMATED TIME SETTINGS ---
    start_interval_saved: 1800            # Seconds until next event starts automatically
    koth_time_saved: 300                  # Capture duration required to win
    no_player_timeout: 600                # Auto-close event if no players interact

# ==========================================
#            INTERNAL SYSTEM CORE
# ==========================================

on load:
    set {koth.start_interval_saved} to {@start_interval_saved}
    set {koth.koth_time_saved} to {@koth_time_saved}
    set {koth.active} to false
    set {koth.next_start} to {koth.start_interval_saved}
    send "[SQKOTH] Core engines successfully compiled with custom shortened lines and exact crate syntax!" to console

every 1 second:
    if {koth.pos1} is set:

        # --- WAITING PHASE (Countdown) ---
        if {koth.active} is false:
            remove 1 from {koth.next_start}
            if {koth.next_start} <= 0:
                execute console command "sqkoth start"
            
            set {_m} to floor({koth.next_start} / 60)
            set {_s} to {koth.next_start} - ({_m} * 60)
            
            execute console command "hologram edit {@hologram} setline 1 &6&lSQKOTH EVENT"
            execute console command "hologram edit {@hologram} setline 2 &eNext Event In:"
            execute console command "hologram edit {@hologram} setline 3 &a%{_m}%m %{_s}%s"
            execute console command "hologram edit {@hologram} setline 4 &7Get Ready for Battle!"

        # --- ACTIVE PHASE (Match Logic via Options Variables) ---
        if {koth.active} is true:
            clear {_players::*}
            set {_w} to world of {koth.pos1}
            loop all players in world {_w}:
                if loop-player's gamemode is survival:
                    if distance between loop-player and {koth.pos1} <= {@hill_radius}:
                        add loop-player to {_players::*} if abs(y-coordinate of loop-player - y-coordinate of {koth.pos1}) <= {@hill_height}

            if size of {_players::*} is 1:
                set {_p} to {_players::1}
                set {koth.status} to "&e&lCAPTURING"
                set {koth.capper} to name of {_p}
                set {koth.timeout_timer} to {@no_player_timeout}
                remove 1 second from {koth.timer}
                if {koth.timer} <= 0 seconds:
                    set {koth.active} to false
                    
                    # --- Broadcast Winner Details (Formatted Shape) ---
                    broadcast " "
                    broadcast "&b&l&m───────────────"
                    broadcast "  &6&l★ EVENT COMPLETED ★"
                    broadcast " "
                    broadcast "  &eWinner » &f%{koth.capper}%"
                    broadcast "  &eRewards Dispatched »"
                    broadcast "  &7» &a5000 Coins &7+ &fCommon Key"
                    broadcast " "
                    broadcast "&b&l&m───────────────"
                    broadcast " "
                    
                    play sound "ui.toast.challenge_complete" with volume 1.5 to all players
                    add {@reward_money} to balance of {_p}
                    set {_final_cmd} to "{@crate_command}"
                    replace "[PLAYER]" with name of {_p} in {_final_cmd}
                    execute console command "%{_final_cmd}%"
                    set {koth.next_start} to {koth.start_interval_saved}

            else if size of {_players::*} > 1:
                set {koth.status} to "&c&lCONTESTED"
                set {koth.capper} to "Multiple"
                set {koth.timeout_timer} to {@no_player_timeout}
            else:
                set {koth.status} to "&7&lWAITING"
                set {koth.capper} to "None"
                
                remove 1 from {koth.timeout_timer}
                if {koth.timeout_timer} <= 0:
                    set {koth.active} to false
                    set {koth.next_start} to {koth.start_interval_saved}
                    broadcast " "
                    broadcast "{@prefix} &cKOTH ended automatically due to 10 minutes of inactivity."
                    broadcast " "

            set {_display} to "%{koth.timer}%"
            replace all " seconds" and " second" with "s" in {_display}
            replace all " minutes" and " minute" with "m" in {_display}
            
            execute console command "hologram edit {@hologram} setline 1 &6&lSQKOTH ACTIVE"
            execute console command "hologram edit {@hologram} setline 2 &fStatus: %{koth.status}%"
            execute console command "hologram edit {@hologram} setline 3 &fTime: &a%{_display}%"
            execute console command "hologram edit {@hologram} setline 4 &fCapper: &e%{koth.capper}%"
# ==========================================
#              COMMAND SYSTEM
# ==========================================

command /sqkoth [<text>]:
    permission: sqkoth.admin
    trigger:
        if arg-1 is not set:
            send "&b&l&m───────&r &e&lSQ-KOTH ADMIN INTERFACE &b&l&m───────" to player
            send "  &7» &b/sqkoth set &8- &fDefine central KOTH arena platform" to player
            send "  &7» &b/sqkoth remove &8- &fClear zone coordinates & refresh holo" to player
            send "  &7» &b/sqkoth start &8- &fForce-start match event instantly" to player
            send "  &7» &b/sqkoth stop &8- &fForce-stop active match event instantly" to player
            send "  &7» &b/sqkoth reload &8- &fHot-reload configuration files smoothly" to player
            send "&b&l&m──────────────────────────────" to player
            stop

        if arg-1 is "reload":
            execute player command "sk reload sqkoth"
            send "{@prefix} &aSystem reloaded and settings applied!"
            stop

        if arg-1 is "remove":
            if {koth.pos1} is not set:
                send "{@prefix} &cThere are no coordinates set to remove! Use &e/sqkoth set &cfirst." to player
                stop
            clear {koth.pos1}
            set {koth.active} to false
            
            execute console command "hologram edit {@hologram} setline 1 &c&lERROR"
            execute console command "hologram edit {@hologram} setline 2 &ePlease define the area"
            execute console command "hologram edit {@hologram} setline 3 &eor put me back in it"
            execute console command "hologram edit {@hologram} setline 4 &r"
            
            send "{@prefix} &eKOTH region coordinates have been successfully removed." to player
            stop

        if arg-1 is "start":
            if {koth.pos1} is not set:
                send "{@prefix} &cPlease set Center Platform (/sqkoth set) first!" to player
                stop
            if {koth.active} is true:
                send "{@prefix} &cThe KOTH event is already active and running!" to player
                stop
                
            set {koth.active} to true
            set {koth.timer} to "%{koth.koth_time_saved}% seconds" parsed as timespan
            set {koth.timeout_timer} to {@no_player_timeout}
            set {koth.status} to "&7&lWAITING"
            set {koth.next_start} to {koth.start_interval_saved}
            
            # --- Event Activation Broadcast ---
            broadcast " "
            broadcast "&6&l&m───────────────"
            broadcast "  &b&l★ EVENT ACTIVATED ★"
            broadcast " "
            broadcast "  &eThe battle has begun!"
            broadcast "  &fCapture the platform to win!"
            broadcast " "
            broadcast "&6&l&m───────────────"
            broadcast " "
            play sound "entity.lightning_bolt.thunder" with volume 1 to all players
            stop
        if arg-1 is "stop":
            if {koth.active} is false:
                send "{@prefix} &cThe KOTH event is already stopped." to player
                stop
            
            # Broadcast the message first to ensure it reaches all players before resetting the engine
            broadcast " "
            broadcast "{@prefix} &c&lEVENT FORCE-STOPPED BY ADMIN"
            broadcast " "
            
            set {koth.active} to false
            set {koth.next_start} to {koth.start_interval_saved}
            stop

        if arg-1 is "set":
            if {koth.pos1} is set:
                send "{@prefix} &cThe KOTH region is already set! Use &e/sqkoth remove &cfirst." to player
                stop
            set {koth.pos1} to player's location
            send "{@prefix} &aKOTH platform region successfully defined!" to player
            execute console command "hologram move {@hologram} %player's x-coordinate% %player's y-coordinate + 2% %player's z-coordinate% %player's world%"
            stop
